{
  "name": "@savvyedge/api",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "default": "./dist/workflow.js"
    },
    "./ingestion-entrypoint": {
      "types": "./dist/ingestion-entrypoint.d.ts",
      "default": "./dist/ingestion-entrypoint.js"
    },
    "./active-evidence": {
      "types": "./dist/active-evidence.d.ts",
      "default": "./dist/active-evidence.js"
    },
    "./snapshot-reprocessing": {
      "types": "./dist/snapshot-reprocessing.d.ts",
      "default": "./dist/snapshot-reprocessing.js"
    },
    "./publication-gate": {
      "types": "./dist/publication-gate.d.ts",
      "default": "./dist/publication-gate.js"
    },
    "./bonus-service": {
      "types": "./dist/bonus-service.d.ts",
      "default": "./dist/bonus-service.js"
    },
    "./casino-service": {
      "types": "./dist/casino-service.d.ts",
      "default": "./dist/casino-service.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./evidence-artifact-retrieval": {
      "types": "./dist/evidence-artifact-retrieval.d.ts",
      "default": "./dist/evidence-artifact-retrieval.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start:orchestrator": "node --import tsx scripts/run-orchestrator.ts",
    "verify-slice": "tsx scripts/verify-vertical-slice.ts",
    "verify-real-scraping": "tsx scripts/verify-real-scraping.ts",
    "verify-discovery": "tsx scripts/verify-discovery-engine.ts",
    "verify-orchestrator": "tsx scripts/verify-orchestrator.ts",
    "verify-tvs": "tsx scripts/verify-tvs-calculator.ts",
    "verify-trust": "tsx scripts/verify-phase1-trust.ts",
    "verify:ukgc": "tsx scripts/verify-ukgc-license.ts",
    "verify:d2": "tsx scripts/verify-d2-vertical-slice.ts",
    "test": "vitest run tests --maxWorkers=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.89.0",
    "@savvyedge/database": "workspace:*",
    "@savvyedge/types": "workspace:*",
    "@savvyedge/ai-agents": "workspace:*"
  },
  "devDependencies": {
    "@savvyedge/config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
