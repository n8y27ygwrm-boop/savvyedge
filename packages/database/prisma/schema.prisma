generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReviewStatus {
  NEW
  AWAITING_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
  QUARANTINED
  SUPERSEDED
}

enum PublicationStatus {
  UNPUBLISHED
  PUBLISHED
  WITHDRAWN
}

enum ActorKind {
  HUMAN
  SERVICE
  SYSTEM
  MIGRATION
}

enum AdminRole {
  REVIEWER
  SENIOR_REVIEWER
  PUBLISHER
  ADMIN
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum EvidenceType {
  OPERATOR_PAGE
  REGULATOR_REGISTER
  PROVIDER_PAGE
  TEST_LAB_REPORT
  FIRST_PARTY_API
  LEGACY_HISTORY_PROXY
}

enum EvidenceVerdict {
  SUPPORTS
  CONTRADICTS
  INCONCLUSIVE
}

enum QuarantineReason {
  DEV_MOCK
  AGGREGATOR_IDENTITY
  UNKNOWN_SOURCE
  INVALID_IDENTITY
  DUPLICATE
  CONFLICTING_EVIDENCE
  EXPIRED_EVIDENCE
  UNVERIFIED_LICENSE
  MANUAL_HOLD
}

enum WorkflowEventType {
  INGESTED
  REVIEW_REQUESTED
  REVIEW_STARTED
  APPROVED
  REJECTED
  QUARANTINED
  QUARANTINE_CLEARED
  MATERIAL_CHANGE_DETECTED
  PUBLISHED
  UNPUBLISHED
  WITHDRAWN
  SUPERSEDED
  MERGED
}

enum GovernedSubjectType {
  CASINO
  BONUS
  SLOT
  LICENSE
}

enum CasinoEvidenceField {
  NAME
  WEBSITE_HOST
  LICENSE_ASSOCIATION
}

enum BonusEvidenceField {
  TYPE
  HEADLINE_VALUE
  WAGERING_REQUIREMENT
  MAX_CONVERSION
  VALID_FROM
  VALID_UNTIL
}

enum SlotEvidenceField {
  NAME
  PROVIDER
  RTP
  VOLATILITY
  MAX_WIN
  RELEASE_DATE
  CASINO_AVAILABILITY
}

enum LicenseEvidenceField {
  LICENSE_NUMBER
  STATUS
  REGULATOR
  CASINO_ASSOCIATION
  VALID_UNTIL
}

model Casino {
  id                 String            @id @default(uuid())
  slug               String            @unique
  name               String
  license_info       String?
  status             String
  website_url        String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  verified_at        DateTime?
  data_source_type   String            @default("SCRAPED")
  review_status      ReviewStatus      @default(NEW)
  publication_status PublicationStatus @default(UNPUBLISHED)
  quarantine_reason  QuarantineReason?
  governance_version Int               @default(0)
  duplicate_of_id    String?

  bonuses                   Bonus[]
  reviews                   Review[]
  history_events            CasinoHistoryEvent[]
  licenses                  License[]
  casino_slots              CasinoSlot[]
  evidence_claims           CasinoEvidenceClaim[]
  domain_candidates         CasinoDomain[]
  workflow_events           WorkflowAuditEvent[]  @relation("CasinoWorkflowSubject")
  canonical_workflow_events WorkflowAuditEvent[]  @relation("CasinoWorkflowCanonical")
  duplicate_of              Casino?               @relation("CasinoDuplicates", fields: [duplicate_of_id], references: [id])
  duplicates                Casino[]              @relation("CasinoDuplicates")

  @@index([slug])
  @@index([review_status, publication_status])
  @@index([duplicate_of_id])
}

model Provider {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  website_url String?

  slots Slot[]

  @@index([slug])
}

model Slot {
  id                        String            @id @default(uuid())
  slug                      String            @unique
  name                      String
  provider_id               String
  rtp_current               Float?
  volatility                String?
  max_win                   Float?
  release_date              DateTime?
  wagering_contribution_pct Float             @default(100)
  review_status             ReviewStatus      @default(NEW)
  publication_status        PublicationStatus @default(UNPUBLISHED)
  quarantine_reason         QuarantineReason?
  governance_version        Int               @default(0)
  duplicate_of_id           String?

  provider                  Provider             @relation(fields: [provider_id], references: [id])
  rtp_history               SlotRtpHistory[]
  casino_slots              CasinoSlot[]
  evidence_claims           SlotEvidenceClaim[]
  workflow_events           WorkflowAuditEvent[] @relation("SlotWorkflowSubject")
  canonical_workflow_events WorkflowAuditEvent[] @relation("SlotWorkflowCanonical")
  duplicate_of              Slot?                @relation("SlotDuplicates", fields: [duplicate_of_id], references: [id])
  duplicates                Slot[]               @relation("SlotDuplicates")

  @@index([slug])
  @@index([provider_id])
  @@index([review_status, publication_status])
  @@index([duplicate_of_id])
}

model SlotRtpHistory {
  id          String   @id @default(uuid())
  slot_id     String
  rtp_value   Float
  recorded_at DateTime @default(now())
  source_url  String?

  slot Slot @relation(fields: [slot_id], references: [id])

  @@index([slot_id])
  @@index([slot_id, recorded_at])
}

model Bonus {
  id                   String            @id @default(uuid())
  casino_id            String
  type                 String
  headline_value       String?
  wagering_requirement Float?
  max_conversion       Float?
  true_value_score     Float?
  valid_from           DateTime?
  valid_until          DateTime?
  status               String
  created_at           DateTime          @default(now())
  updated_at           DateTime          @default(now()) @updatedAt
  verified_at          DateTime?
  data_source_type     String            @default("SCRAPED")
  source_offer_key     String?
  review_status        ReviewStatus      @default(NEW)
  publication_status   PublicationStatus @default(UNPUBLISHED)
  quarantine_reason    QuarantineReason?
  governance_version   Int               @default(0)
  duplicate_of_id      String?

  casino                    Casino                    @relation(fields: [casino_id], references: [id])
  history_events            BonusHistoryEvent[]
  evidence_claims           BonusEvidenceClaim[]
  active_extractions        ActiveExtractionPointer[]
  workflow_events           WorkflowAuditEvent[]      @relation("BonusWorkflowSubject")
  canonical_workflow_events WorkflowAuditEvent[]      @relation("BonusWorkflowCanonical")
  duplicate_of              Bonus?                    @relation("BonusDuplicates", fields: [duplicate_of_id], references: [id])
  duplicates                Bonus[]                   @relation("BonusDuplicates")

  @@index([casino_id])
  @@unique([casino_id, source_offer_key])
  @@index([review_status, publication_status])
  @@index([duplicate_of_id])
}

model BonusHistoryEvent {
  id            String   @id @default(uuid())
  bonus_id      String
  field_changed String
  old_value     String?
  new_value     String?
  changed_at    DateTime @default(now())
  source_url    String?

  bonus Bonus @relation(fields: [bonus_id], references: [id])

  @@index([bonus_id])
  @@index([bonus_id, changed_at])
}

model CasinoHistoryEvent {
  id          String   @id @default(uuid())
  casino_id   String
  event_type  String
  description String
  occurred_at DateTime @default(now())
  source_url  String?

  casino Casino @relation(fields: [casino_id], references: [id])

  @@index([casino_id])
  @@index([casino_id, occurred_at])
}

model Review {
  id                  String    @id @default(uuid())
  casino_id           String
  author_type         String
  content             String    @db.Text
  rating              Float
  methodology_version String?
  published_at        DateTime?
  last_verified_at    DateTime?

  casino Casino @relation(fields: [casino_id], references: [id])

  @@index([casino_id])
}

model DataSource {
  id                String    @id @default(uuid())
  url               String
  normalized_url    String?
  source_type       String
  last_scraped_at   DateTime?
  reliability_score Float?

  scrape_jobs        ScrapeJob[]
  evidence_records   EvidenceRecord[]
  active_extractions ActiveExtractionPointer[]

  @@index([normalized_url])
}

model ScrapeJob {
  id             String    @id @default(uuid())
  data_source_id String
  status         String
  started_at     DateTime  @default(now())
  completed_at   DateTime?
  error_log      String?   @db.Text
  snapshot_path  String?
  retry_count    Int       @default(0)
  geo_fallback_checkpoint Json?
  html_hash      String?
  content_hash   String?
  canonical_url  String?

  /// Set only on a REPROCESS_SNAPSHOT execution: the job whose stored
  /// authoritative artifact this run re-interpreted. Null for normal crawls.
  reprocessed_from_id String?
  /// The extraction contract version this execution was requested and run under.
  extraction_version  String?

  data_source      DataSource       @relation(fields: [data_source_id], references: [id])
  evidence_records EvidenceRecord[]

  reprocessed_from ScrapeJob?  @relation("SnapshotReprocessing", fields: [reprocessed_from_id], references: [id])
  reprocessings    ScrapeJob[] @relation("SnapshotReprocessing")

  @@index([data_source_id])
  @@index([reprocessed_from_id])
}

model Jurisdiction {
  id         String      @id @default(uuid())
  slug       String      @unique
  name       String
  country    String?
  regulators Regulator[]

  @@index([slug])
}

model Regulator {
  id              String  @id @default(uuid())
  slug            String  @unique
  name            String
  jurisdiction_id String
  website_url     String?

  jurisdiction Jurisdiction @relation(fields: [jurisdiction_id], references: [id])
  licenses     License[]

  @@index([slug])
  @@index([jurisdiction_id])
}

model License {
  id                    String            @id @default(uuid())
  casino_id             String
  regulator_id          String
  license_no            String
  normalized_license_no String?
  status                String // e.g. "ACTIVE", "INACTIVE", "SUSPENDED"
  verified_at           DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  review_status         ReviewStatus      @default(NEW)
  quarantine_reason     QuarantineReason?
  governance_version    Int               @default(0)
  duplicate_of_id       String?

  casino                    Casino                 @relation(fields: [casino_id], references: [id])
  regulator                 Regulator              @relation(fields: [regulator_id], references: [id])
  evidence_claims           LicenseEvidenceClaim[]
  workflow_events           WorkflowAuditEvent[]   @relation("LicenseWorkflowSubject")
  canonical_workflow_events WorkflowAuditEvent[]   @relation("LicenseWorkflowCanonical")
  duplicate_of              License?               @relation("LicenseDuplicates", fields: [duplicate_of_id], references: [id])
  duplicates                License[]              @relation("LicenseDuplicates")

  @@index([casino_id])
  @@index([regulator_id])
  @@index([license_no])
  @@index([normalized_license_no])
  @@index([review_status])
  @@index([duplicate_of_id])
}

model WorkerNode {
  id             String   @id @default(uuid())
  worker_name    String   @unique
  status         String // "ACTIVE", "STOPPING", "DEAD"
  active_jobs    Int      @default(0)
  last_heartbeat DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([status, last_heartbeat])
}

model JobQueue {
  id           String    @id @default(uuid())
  queue_name   String // e.g. "crawling-queue", "extraction-queue", "orchestrator-queue"
  task_type    String // e.g. "DISCOVER_SEEDS", "INGEST_URL", "CRAWL_URL", "EXTRACT_BONUS", "VALIDATE_BONUS"
  payload      String    @db.Text // JSON string of arguments
  status       String // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  priority     String    @default("NORMAL") // "HIGH", "NORMAL", "LOW"
  domain       String?
  worker_id    String?
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  run_at       DateTime  @default(now())
  locked_until DateTime?
  error_log    String?   @db.Text
  started_at   DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([queue_name, status, run_at])
  @@index([queue_name, status, priority, run_at])
  @@index([domain, status])
}

model DiscoveredUrl {
  id             String   @id @default(uuid())
  url            String   @unique
  normalized_url String   @unique
  domain         String
  source_seed    String
  status         String // "DISCOVERED", "ENQUEUED", "FILTERED", "PROCESSED"
  filter_reason  String?
  discovered_at  DateTime @default(now())

  @@index([domain])
  @@index([status])
}

model CasinoSlot {
  id          String    @id @default(uuid())
  casino_id   String
  slot_id     String
  source_url  String?
  verified_at DateTime?
  created_at  DateTime  @default(now())

  casino Casino @relation(fields: [casino_id], references: [id])
  slot   Slot   @relation(fields: [slot_id], references: [id])

  @@unique([casino_id, slot_id])
  @@index([casino_id])
  @@index([slot_id])
}

model ReviewActor {
  id               String    @id @default(uuid())
  kind             ActorKind
  stable_key       String    @unique
  display_name     String
  external_subject String?   @unique
  active           Boolean   @default(true)
  created_at       DateTime  @default(now())

  created_evidence EvidenceRecord[]
  workflow_events  WorkflowAuditEvent[]
  admin_user       AdminUser?

  @@index([kind, active])
}

model AdminUser {
  id            String          @id @default(uuid())
  email         String          @unique
  display_name  String
  password_hash String
  role          AdminRole       @default(REVIEWER)
  status        AdminUserStatus @default(ACTIVE)
  actor_id      String          @unique
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  last_login_at DateTime?

  actor    ReviewActor    @relation(fields: [actor_id], references: [id])
  sessions AdminSession[]

  @@index([email])
  @@index([role, status])
}

model AdminSession {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?

  user AdminUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at, revoked_at])
}

model EvidenceRecord {
  id             String       @id @default(uuid())
  data_source_id String
  scrape_job_id  String?
  evidence_type  EvidenceType
  source_url     String
  snapshot_path  String?
  html_hash      String?
  content_hash   String?
  extraction_key String?
  observed_at    DateTime
  extracted_at   DateTime
  valid_from     DateTime?
  expires_at     DateTime?
  created_by_id  String
  created_at     DateTime     @default(now())

  data_source     DataSource                @relation(fields: [data_source_id], references: [id])
  scrape_job      ScrapeJob?                @relation(fields: [scrape_job_id], references: [id])
  created_by      ReviewActor               @relation(fields: [created_by_id], references: [id])
  casino_claims   CasinoEvidenceClaim[]
  bonus_claims    BonusEvidenceClaim[]
  slot_claims     SlotEvidenceClaim[]
  license_claims  LicenseEvidenceClaim[]
  active_pointers ActiveExtractionPointer[]

  /// Exactly one effective extraction per data source, authoritative artifact,
  /// extraction context and contract version. Legacy NULL keys are exempt
  /// because PostgreSQL treats NULL as distinct in a unique index.
  @@unique([data_source_id, extraction_key], map: "EvidenceRecord_data_source_id_extraction_key_key")
  @@index([data_source_id, observed_at])
  @@index([scrape_job_id])
  @@index([expires_at])
  @@index([content_hash])
}

/// Explicit pointer to the extraction result that is currently authoritative
/// for governance, per bonus and extraction context.
///
/// Historical EvidenceRecord and claim rows are never mutated or deleted; a
/// record becomes historical purely by no longer being referenced here. The
/// pointer is moved only inside the same Serializable transaction that commits
/// the evidence, its claims, the Bonus/history writes and ScrapeJob completion.
model ActiveExtractionPointer {
  id                 String   @id @default(uuid())
  /// Governance subject. The pointer is bonus-scoped because no database
  /// constraint restricts a DataSource to a single Bonus: Bonus has no
  /// data_source_id column at all, and its only unique is
  /// (casino_id, source_offer_key). Scoping by data source would let a
  /// reverification of one bonus silently supersede another bonus's evidence.
  bonus_id           String
  /// V1 supports "BONUS" only.
  extraction_context String
  /// Retained for integrity and diagnostics, never for resolution.
  data_source_id     String
  evidence_id        String
  /// Denormalised for audit: why this record is active, without a join.
  extraction_key     String
  contract_version   String
  activated_at       DateTime @default(now())

  bonus       Bonus          @relation(fields: [bonus_id], references: [id])
  data_source DataSource     @relation(fields: [data_source_id], references: [id])
  evidence    EvidenceRecord @relation(fields: [evidence_id], references: [id])

  @@unique([bonus_id, extraction_context], map: "ActiveExtractionPointer_bonus_id_extraction_context_key")
  @@index([evidence_id])
  @@index([data_source_id])
}

model CasinoEvidenceClaim {
  id                    String              @id @default(uuid())
  evidence_id           String
  casino_id             String
  field                 CasinoEvidenceField
  observed_value        String              @db.Text
  normalized_value_hash String
  verdict               EvidenceVerdict
  created_at            DateTime            @default(now())

  evidence              EvidenceRecord       @relation(fields: [evidence_id], references: [id])
  casino                Casino               @relation(fields: [casino_id], references: [id])
  workflow_event_claims WorkflowEventClaim[]
  domain_candidates     CasinoDomain[]

  @@unique([evidence_id, casino_id, field])
  @@index([casino_id, field, verdict])
  @@index([normalized_value_hash])
}

model BonusEvidenceClaim {
  id                    String             @id @default(uuid())
  evidence_id           String
  bonus_id              String
  field                 BonusEvidenceField
  observed_value        String             @db.Text
  normalized_value_hash String
  verdict               EvidenceVerdict
  created_at            DateTime           @default(now())

  evidence              EvidenceRecord       @relation(fields: [evidence_id], references: [id])
  bonus                 Bonus                @relation(fields: [bonus_id], references: [id])
  workflow_event_claims WorkflowEventClaim[]

  @@unique([evidence_id, bonus_id, field])
  @@index([bonus_id, field, verdict])
  @@index([normalized_value_hash])
}

model SlotEvidenceClaim {
  id                    String            @id @default(uuid())
  evidence_id           String
  slot_id               String
  field                 SlotEvidenceField
  observed_value        String            @db.Text
  normalized_value_hash String
  verdict               EvidenceVerdict
  created_at            DateTime          @default(now())

  evidence              EvidenceRecord       @relation(fields: [evidence_id], references: [id])
  slot                  Slot                 @relation(fields: [slot_id], references: [id])
  workflow_event_claims WorkflowEventClaim[]

  @@unique([evidence_id, slot_id, field])
  @@index([slot_id, field, verdict])
  @@index([normalized_value_hash])
}

model LicenseEvidenceClaim {
  id                    String               @id @default(uuid())
  evidence_id           String
  license_id            String
  field                 LicenseEvidenceField
  observed_value        String               @db.Text
  normalized_value_hash String
  verdict               EvidenceVerdict
  created_at            DateTime             @default(now())

  evidence              EvidenceRecord       @relation(fields: [evidence_id], references: [id])
  license               License              @relation(fields: [license_id], references: [id])
  workflow_event_claims WorkflowEventClaim[]

  @@unique([evidence_id, license_id, field])
  @@index([license_id, field, verdict])
  @@index([normalized_value_hash])
}

model CasinoDomain {
  id                String   @id @default(uuid())
  casino_id         String
  normalized_host   String
  evidence_claim_id String?
  created_at        DateTime @default(now())

  casino         Casino               @relation(fields: [casino_id], references: [id])
  evidence_claim CasinoEvidenceClaim? @relation(fields: [evidence_claim_id], references: [id])

  @@index([casino_id])
  @@index([normalized_host])
  @@index([evidence_claim_id])
}

model WorkflowAuditEvent {
  id                      String              @id @default(uuid())
  subject_type            GovernedSubjectType
  casino_id               String?
  bonus_id                String?
  slot_id                 String?
  license_id              String?
  actor_id                String
  event_type              WorkflowEventType
  from_review_status      ReviewStatus?
  to_review_status        ReviewStatus?
  from_publication_status PublicationStatus?
  to_publication_status   PublicationStatus?
  quarantine_reason       QuarantineReason?
  expected_version        Int
  resulting_version       Int
  canonical_casino_id     String?
  canonical_bonus_id      String?
  canonical_slot_id       String?
  canonical_license_id    String?
  internal_note           String?             @db.Text
  occurred_at             DateTime            @default(now())

  casino            Casino?              @relation("CasinoWorkflowSubject", fields: [casino_id], references: [id], onDelete: SetNull)
  bonus             Bonus?               @relation("BonusWorkflowSubject", fields: [bonus_id], references: [id], onDelete: SetNull)
  slot              Slot?                @relation("SlotWorkflowSubject", fields: [slot_id], references: [id], onDelete: SetNull)
  license           License?             @relation("LicenseWorkflowSubject", fields: [license_id], references: [id], onDelete: SetNull)
  canonical_casino  Casino?              @relation("CasinoWorkflowCanonical", fields: [canonical_casino_id], references: [id], onDelete: Restrict)
  canonical_bonus   Bonus?               @relation("BonusWorkflowCanonical", fields: [canonical_bonus_id], references: [id], onDelete: Restrict)
  canonical_slot    Slot?                @relation("SlotWorkflowCanonical", fields: [canonical_slot_id], references: [id], onDelete: Restrict)
  canonical_license License?             @relation("LicenseWorkflowCanonical", fields: [canonical_license_id], references: [id], onDelete: Restrict)
  actor             ReviewActor          @relation(fields: [actor_id], references: [id])
  evidence_claims   WorkflowEventClaim[]

  @@index([casino_id, occurred_at])
  @@index([bonus_id, occurred_at])
  @@index([slot_id, occurred_at])
  @@index([license_id, occurred_at])
  @@index([canonical_casino_id])
  @@index([canonical_bonus_id])
  @@index([canonical_slot_id])
  @@index([canonical_license_id])
  @@index([actor_id, occurred_at])
}

model WorkflowEventClaim {
  id                        String  @id @default(uuid())
  workflow_event_id         String
  casino_evidence_claim_id  String?
  bonus_evidence_claim_id   String?
  slot_evidence_claim_id    String?
  license_evidence_claim_id String?

  workflow_event         WorkflowAuditEvent    @relation(fields: [workflow_event_id], references: [id])
  casino_evidence_claim  CasinoEvidenceClaim?  @relation(fields: [casino_evidence_claim_id], references: [id])
  bonus_evidence_claim   BonusEvidenceClaim?   @relation(fields: [bonus_evidence_claim_id], references: [id])
  slot_evidence_claim    SlotEvidenceClaim?    @relation(fields: [slot_evidence_claim_id], references: [id])
  license_evidence_claim LicenseEvidenceClaim? @relation(fields: [license_evidence_claim_id], references: [id])

  @@index([workflow_event_id])
  @@index([casino_evidence_claim_id])
  @@index([bonus_evidence_claim_id])
  @@index([slot_evidence_claim_id])
  @@index([license_evidence_claim_id])
}
