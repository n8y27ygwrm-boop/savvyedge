# ==========================================
# SavvyEdge Monorepo Environment Contract
# ==========================================

# Database Connection URLs (Required)
# DATABASE_URL: Transaction/pooled connection for application runtime
# DIRECT_URL: Direct session connection for Prisma migrations (Supabase port 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5432/savvyedge"
DIRECT_URL="postgresql://postgres:password@localhost:5432/savvyedge"

# Environment Designation (Optional, defaults to local/development)
# Options: local | development | staging | production
NEXT_PUBLIC_APP_ENV="development"
SAVVY_ENV="development"

# Durable evidence storage
# Development/test may use filesystem. Production must explicitly use supabase.
SAVVY_EVIDENCE_STORAGE_BACKEND="filesystem"
SAVVY_SNAPSHOT_ROOT="storage/snapshots"
# Server-only Supabase Storage configuration required when backend=supabase.
# Never expose the secret through a NEXT_PUBLIC_* variable.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_SECRET_KEY="replace-with-server-only-supabase-secret-key"
SAVVY_EVIDENCE_STORAGE_BUCKET="savvyedge-evidence"

# Security & Authentication Secrets (Required in staging/production)
# Fail closed if unconfigured in production/staging environments
ADMIN_JWT_SECRET="replace-with-secure-random-64-char-hex-key"

# Internal Service Secret (Required for internal API route authentication)
INTERNAL_API_SECRET="replace-with-secure-internal-api-secret"

# Admin Bootstrap Credentials (Required only for scripts/bootstrap-admin.ts)
SEED_ADMIN_EMAIL="admin@savvyedge.com"
SEED_ADMIN_PASSWORD="ReplaceWithSecurePassword123!"
SEED_ADMIN_NAME="System Administrator"
FORCE_BOOTSTRAP="false"
